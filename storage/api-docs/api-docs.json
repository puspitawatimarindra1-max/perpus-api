{
    "openapi": "3.0.0",
    "info": {
        "title": "Perpustakaan API",
        "description": "REST API Laravel untuk autentikasi Sanctum dan pengelolaan katalog buku.",
        "contact": {
            "name": "Admin Perpustakaan",
            "email": "admin@example.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Server API"
        }
    ],
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Registrasi pengguna",
                "operationId": "register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registrasi berhasil dan access token dibuat",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validasi gagal",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login pengguna",
                "description": "Dibatasi hingga 6 percobaan per menit.",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login berhasil dan access token dibuat",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validasi gagal atau kredensial salah",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Terlalu banyak percobaan login"
                    }
                }
            }
        },
        "/api/me": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Pengguna yang sedang login",
                "operationId": "getAuthenticatedUser",
                "responses": {
                    "200": {
                        "description": "Data pengguna terautentikasi",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token tidak ada atau tidak valid"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout pengguna",
                "description": "Menghapus token akses yang sedang digunakan.",
                "operationId": "logout",
                "responses": {
                    "200": {
                        "description": "Logout berhasil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MessageResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token tidak ada atau tidak valid"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/books": {
            "get": {
                "tags": [
                    "Books"
                ],
                "summary": "Daftar buku",
                "description": "Mengembalikan buku terbaru terlebih dahulu dengan paginasi opsional dan pencarian judul atau penulis.",
                "operationId": "listBooks",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Kata kunci judul atau penulis",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Jumlah buku per halaman (1-100, default 10)",
                        "schema": {
                            "type": "integer",
                            "default": 10,
                            "maximum": 100,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Nomor halaman",
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Daftar buku berhasil diambil",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookCollection"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token tidak ada atau tidak valid"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Books"
                ],
                "summary": "Tambah buku",
                "operationId": "createBook",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BookRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Buku berhasil dibuat",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validasi gagal atau ISBN sudah digunakan",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token tidak ada atau tidak valid"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/books/{book}": {
            "get": {
                "tags": [
                    "Books"
                ],
                "summary": "Detail buku",
                "operationId": "getBook",
                "parameters": [
                    {
                        "name": "book",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detail buku",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token tidak ada atau tidak valid"
                    },
                    "404": {
                        "description": "Buku tidak ditemukan"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Books"
                ],
                "summary": "Perbarui buku",
                "description": "Field dapat dikirim sebagian; field yang disediakan harus memenuhi validasi.",
                "operationId": "replaceBookFields",
                "parameters": [
                    {
                        "name": "book",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BookUpdate"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Buku berhasil diperbarui",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validasi gagal atau ISBN sudah digunakan",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token tidak ada atau tidak valid"
                    },
                    "404": {
                        "description": "Buku tidak ditemukan"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Books"
                ],
                "summary": "Hapus buku",
                "operationId": "deleteBook",
                "parameters": [
                    {
                        "name": "book",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Buku berhasil dihapus",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MessageResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token tidak ada atau tidak valid"
                    },
                    "404": {
                        "description": "Buku tidak ditemukan"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "patch": {
                "tags": [
                    "Books"
                ],
                "summary": "Perbarui sebagian field buku",
                "operationId": "partiallyUpdateBook",
                "parameters": [
                    {
                        "name": "book",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BookUpdate"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Buku berhasil diperbarui",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BookResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validasi gagal atau ISBN sudah digunakan",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token tidak ada atau tidak valid"
                    },
                    "404": {
                        "description": "Buku tidak ditemukan"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "TokenResponse": {
                "type": "object",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/MessageResponse"
                    },
                    {
                        "properties": {
                            "message": {
                                "type": "string",
                                "example": "Login berhasil"
                            },
                            "token": {
                                "type": "string",
                                "example": "1|your-personal-access-token"
                            },
                            "token_type": {
                                "type": "string",
                                "example": "Bearer"
                            },
                            "user": {
                                "$ref": "#/components/schemas/User"
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "ValidationError": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "The given data was invalid."
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            },
            "MessageResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Buku berhasil dihapus"
                    }
                },
                "type": "object"
            },
            "LoginInput": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password"
                    },
                    "device_name": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 100
                    }
                },
                "type": "object"
            },
            "RegisterInput": {
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Nama Pengguna",
                        "maxLength": 100
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "minLength": 8
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password"
                    }
                },
                "type": "object"
            },
            "BookRequest": {
                "required": [
                    "title",
                    "author",
                    "isbn",
                    "published_year",
                    "stock"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "Bumi Manusia",
                        "maxLength": 255
                    },
                    "author": {
                        "type": "string",
                        "example": "Pramoedya Ananta Toer",
                        "maxLength": 255
                    },
                    "publisher": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 255
                    },
                    "isbn": {
                        "type": "string",
                        "example": "9789799731234",
                        "maxLength": 20
                    },
                    "published_year": {
                        "type": "integer",
                        "example": 1980,
                        "minimum": 1000
                    },
                    "stock": {
                        "type": "integer",
                        "example": 12,
                        "minimum": 0
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "BookUpdate": {
                "description": "Kirim hanya field yang ingin diubah. Field yang dikirim tetap harus valid.",
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "author": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "publisher": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 255
                    },
                    "isbn": {
                        "type": "string",
                        "maxLength": 20
                    },
                    "published_year": {
                        "type": "integer",
                        "minimum": 1000
                    },
                    "stock": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Book": {
                "required": [
                    "id",
                    "title",
                    "author",
                    "isbn",
                    "published_year",
                    "stock"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Bumi Manusia"
                    },
                    "author": {
                        "type": "string",
                        "example": "Pramoedya Ananta Toer"
                    },
                    "publisher": {
                        "type": "string",
                        "example": "Lentera Dipantara",
                        "nullable": true
                    },
                    "isbn": {
                        "type": "string",
                        "example": "9789799731234"
                    },
                    "published_year": {
                        "type": "integer",
                        "example": 1980
                    },
                    "stock": {
                        "type": "integer",
                        "example": 12
                    },
                    "description": {
                        "type": "string",
                        "example": "Tetralogi Buru bagian pertama.",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "BookResource": {
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/Book"
                    }
                },
                "type": "object"
            },
            "BookCollection": {
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Book"
                        }
                    },
                    "links": {
                        "type": "object",
                        "additionalProperties": true
                    },
                    "meta": {
                        "type": "object",
                        "additionalProperties": true
                    }
                },
                "type": "object"
            },
            "User": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Nama Pengguna"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "UserResource": {
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/User"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Gunakan token dari endpoint login dengan format Bearer <token>.",
                "bearerFormat": "Sanctum token",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Registrasi dan autentikasi pengguna"
        },
        {
            "name": "Books",
            "description": "Pengelolaan katalog buku"
        }
    ]
}